<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sistema[
<!ELEMENT sistema (usuario+,roles+,logs+)>
<!ELEMENT usuario (nombre,rol-ref,configuracion)>
<!ATTLIST usuario id CDATA #REQUIRED>
<!ELEMENT nombre (#PCDATA)>
<!ELEMENT rol-ref EMPTY>
<!ATTLIST rol-ref idref CDATA #REQUIRED>
<!ELEMENT configuracion (tema,notificaciones) >
<!ELEMENT tema (#PCDATA) >
<!ELEMENT notificaciones (email?,sms?)>
<!ELEMENT email (Activado | Desactivado)>
<!ELEMENT sms (Activado | Desactivado)>
<!ELEMENT roles (rol)+>
<!ELEMENT rol (nombre-rol,permisos*)>
<!ATTLIST rol id-rol CDATA #REQUIRED>
<!ELEMENT nombre-rol (#PCDATA)>
<!ELEMENT permisos (permiso | noexistepermiso)>
<!ELEMENT permiso (#PCDATA)>
<!ELEMENT noexistepermiso EMPTY>
<!ELEMENT logs (log)+>
<!ELEMENT log (usuario-ref,accion,fecha)>
<!ELEMENT usuario-ref EMPTY>
<!ATTLIST usuario-ref idref (IDREF) #REQUIRED>
<!ELEMENT accion (#PCDATA)>
<!ELEMENT fecha (#PCDATA)>
]>
